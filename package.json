{
  "name": "markdown-wysiwyg-editor",
  "displayName": "Markdown WYSIWYG Editor",
  "description": "A WYSIWYG editor for Markdown files in VS Code",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "author": {
    "name": "red tea"
  },
  "license": "CC-BY-NC-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/atsushi-green/vscode-Markdown-WYSIWYG"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "rich text",
    "visual editor"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdown-wysiwyg-editor.openEditor",
        "title": "Markdown: WYSIWYGエディタで開く",
        "category": "Markdown WYSIWYG"
      },
      {
        "command": "markdown-wysiwyg-editor.openAsText",
        "title": "Markdown: テキストエディタで開く",
        "category": "Markdown WYSIWYG"
      },
      {
        "command": "markdown-wysiwyg-editor.toggleEditor",
        "title": "Markdown: エディタ切り替え (WYSIWYG/テキスト)",
        "category": "Markdown WYSIWYG"
      },
      {
        "command": "markdown-wysiwyg-editor.newMarkdownFile",
        "title": "Markdown: 新しいWYSIWYGドキュメントを作成",
        "category": "Markdown WYSIWYG"
      },
      {
        "command": "markdown-wysiwyg-editor.toggleToolbar",
        "title": "Markdown: ツールバーの表示/非表示を切り替え",
        "category": "Markdown WYSIWYG"
      }
    ],
    "configuration": {
      "title": "Markdown WYSIWYG Editor",
      "properties": {
        "markdownWysiwyg.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "WYSIWYGエディタ上部のツールバーを表示します。オフにすると本文の表示領域が広がります（コマンド「Markdown: ツールバーの表示/非表示を切り替え」でも切り替えられます）。"
        }
      }
    },
    "keybindings": [
      {
        "command": "markdown-wysiwyg-editor.toggleEditor",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "resourceLangId == markdown"
      }
    ],
    "customEditors": [
      {
        "viewType": "markdownWysiwyg.editor",
        "displayName": "Markdown WYSIWYG Editor",
        "selector": [
          {
            "filenamePattern": "{file,untitled,vscode-remote,vscode-vfs,vscode-userdata,vsls}:/**/*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdown-wysiwyg-editor.openEditor",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "markdown-wysiwyg-editor.openAsText",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "markdown-wysiwyg-editor.toggleEditor",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "markdown-wysiwyg-editor.newMarkdownFile"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd --exit \"out/test/unit/**/*.test.js\"",
    "test:all": "npm run test:unit && npm test",
    "docs:build": "node scripts/docs-site/build.js"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11"
  }
}
